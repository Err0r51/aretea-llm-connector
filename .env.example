# Aretea Drive MCP connector — environment (NAMES ONLY; never commit real values, NFR7).
# Set these as Railway variables / from 1Password.

# --- Drive hop (service account) ---
# The entire service-account key JSON, as a single-line string.
GOOGLE_SA_KEY_JSON=
# The one Shared Drive the service account may read. This is the data boundary.
AI_VISIBLE_DRIVE_ID=

# --- Client hop (identity-only OIDC via FastMCP GoogleProvider) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Exact deployed HTTPS URL — must equal the RFC 9728 resource claude.ai sees (e.g. https://xxx.up.railway.app).
PUBLIC_SERVER_URL=
ALLOWED_EMAIL_DOMAIN=aretea-group.com

# --- Fixed secrets (MUST be stable across restarts, NOT regenerated per boot) ---
# FastMCP signs/verifies our bearer token with this.
JWT_SIGNING_KEY=
# Fernet key for at-rest token storage (A1). Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=

# --- Storage / read guardrails ---
# Path on the Railway persistent volume.
STORAGE_DIR=/data/storage
MAX_READ_CHARS=200000
DRIVE_NUM_RETRIES=5
